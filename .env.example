# Copy to .env, or run npm run setup. Never commit .env.
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./data/unsaid.db
# Required in production. Exact public HTTPS origin, without a trailing slash.
# PUBLIC_ORIGIN=https://unsaid.example.com
# UNSAID_DOMAIN=unsaid.example.com
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Setup generates this locally. Configure it securely on your deployed server.
ADMIN_TOKEN=
# Set ONLY to the exact number of trusted reverse proxies in front of Node.
TRUST_PROXY_HOPS=0
# Enable only in isolated automated tests; production refuses this setting.
# DISABLE_RATE_LIMIT=false
